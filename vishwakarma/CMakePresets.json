{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-ninja",
      "displayName": "Linux Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VISHWAKARMA_BUILD_SAMPLES": "ON",
        "VISHWAKARMA_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-ninja",
      "configurePreset": "linux-ninja"
    }
  ],
  "testPresets": [
    {
      "name": "linux-ninja",
      "configurePreset": "linux-ninja",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
