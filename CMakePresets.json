{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC",
      "description": "Default Windows configuration with Visual Studio",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "${sourceDir}/external/vcpkg/scripts/buildsystems/vcpkg.cmake"
        },
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "AGA_BUILD_SAMPLES": "ON",
        "AGA_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-msvc-ninja",
      "displayName": "Windows MSVC + Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "${sourceDir}/external/vcpkg/scripts/buildsystems/vcpkg.cmake"
        },
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "linux-ninja",
      "displayName": "Linux Ninja",
      "description": "Default Linux configuration using Ninja and the system toolchain",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "AGA_BUILD_SAMPLES": "ON",
        "AGA_BUILD_TESTS": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-ninja-coverage",
      "displayName": "Linux Ninja with coverage",
      "description": "Linux configuration with GCC/Clang coverage instrumentation enabled",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "AGA_BUILD_SAMPLES": "ON",
        "AGA_BUILD_TESTS": "ON",
        "AGA_ENABLE_COVERAGE": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    },
    {
      "name": "linux-ninja",
      "configurePreset": "linux-ninja",
      "configuration": "Debug"
    },
    {
      "name": "linux-ninja-coverage",
      "configurePreset": "linux-ninja-coverage",
      "configuration": "Debug"
    }
  ]
}